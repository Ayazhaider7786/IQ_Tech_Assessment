<Project Sdk="Aspire.AppHost.Sdk/13.1.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>f30c03b5-1ed3-4297-b8da-94d479e1f741</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyApp.Server\MyApp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.1.2" />
    <!-- Requires Docker — uncomment alongside AddSqlServer in AppHost.cs to use an Aspire-hosted SQL Server container. -->
    <!-- <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.1.2" /> -->
    <!-- Pins the transitive MessagePack dependency (pulled in by Aspire.Hosting.JavaScript's
         dashboard resource model) past several known CVEs in 2.5.192. Staying on the 2.x line
         rather than jumping to 3.x avoids that major version's breaking API changes. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>
</Project>
